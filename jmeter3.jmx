      <hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC_UC08a_Запрос_В_БД_Дополнительное" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
