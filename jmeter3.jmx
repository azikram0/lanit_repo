        <hashTree>
          <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="SC_UC08a_Запрос_В_БД_Дополнительное" enabled="true"/>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="&gt;_sandbox:23233/update/?action=delete" enabled="true">
              <stringProp name="dataSource">helpdeskDB</stringProp>
              <stringProp name="query">DO $$
DECLARE
	selected_id INTEGER;
BEGIN

	SELECT id INTO selected_id
	FROM helpdesk_ticket
	WHERE status = 5
	ORDER BY RANDOM() LIMIT 1
	FOR UPDATE SKIP LOCKED;

	IF selected_id IS NULL THEN
		RETURN;
	END IF;
	
	DELETE FROM helpdesk_followupattachment a
	USING helpdesk_followup f
	WHERE a.followup_id = f.id AND f.ticket_id = selected_id;

	DELETE FROM helpdesk_ticketchange c
	USING helpdesk_followup f
	WHERE c.followup_id = f.id AND f.ticket_id = selected_id;

	DELETE FROM helpdesk_followup
	WHERE ticket_id = selected_id;

	DELETE FROM helpdesk_ticketcc
	WHERE ticket_id = selected_id;

	DELETE FROM helpdesk_ticketcustomfieldvalue
	WHERE ticket_id = selected_id;

	DELETE FROM helpdesk_ticketdependency
	WHERE ticket_id = selected_id OR depends_on_id = selected_id;

	UPDATE helpdesk_ticket
	SET merged_to_id = NULL
	WHERE merged_to_id = selected_id;

	DELETE FROM helpdesk_ticket
	WHERE id = selected_id;
END $$;</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="queryType">Update Statement</stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="TF_UC08b_Очистка_БД_Дополнительное" enabled="true"/>
      <hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC_UC08b_Очистка_БД_Дополнительное" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="SC_UC08b_Очистка_БД_Дополнительное" enabled="true"/>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="&gt;_sandbox:23233/update/?action=delete_all" enabled="true">
              <stringProp name="dataSource">helpdeskDB</stringProp>
              <stringProp name="queryType">Update Statement</stringProp>
              <stringProp name="query">DO $$
BEGIN

	IF NOT EXISTS (
		SELECT 1 FROM auth_user
		WHERE id = 1 AND username = &apos;admin&apos; AND is_superuser = true
    	) THEN
        	RAISE EXCEPTION &apos;Администратор не найден&apos;;
    	END IF;

    	DELETE FROM helpdesk_followupattachment;
    	DELETE FROM helpdesk_ticketchange;
    	DELETE FROM helpdesk_followup;
    	DELETE FROM helpdesk_ticketdependency;
    	DELETE FROM helpdesk_ticketcustomfieldvalue;
    	DELETE FROM helpdesk_ticketcc;
    	DELETE FROM helpdesk_ticket;

    	DELETE FROM helpdesk_savedsearch
    	WHERE user_id &lt;&gt; 1;

    	DELETE FROM helpdesk_usersettings
    	WHERE user_id &lt;&gt; 1;

    	DELETE FROM helpdesk_kbitem_voted_by
    	WHERE user_id &lt;&gt; 1;

    	DELETE FROM helpdesk_kbitem_downvoted_by
    	WHERE user_id &lt;&gt; 1;

    	DELETE FROM django_admin_log
    	WHERE user_id &lt;&gt; 1;

    	DELETE FROM pinax_invitations_invitationstat
    	WHERE user_id &lt;&gt; 1;

    	DELETE FROM pinax_teams_membership
    	WHERE user_id &lt;&gt; 1
       	OR invite_id IN (
           	SELECT id
           	FROM pinax_invitations_joininvitation
           	WHERE from_user_id &lt;&gt; 1 OR to_user_id &lt;&gt; 1 OR signup_code_id IN (
                  	SELECT id FROM account_signupcode
                  	WHERE inviter_id &lt;&gt; 1
              	)
       	);

    	DELETE FROM pinax_teams_simplemembership
    	WHERE user_id &lt;&gt; 1 OR invite_id IN (
           	SELECT id
           	FROM pinax_invitations_joininvitation
           	WHERE from_user_id &lt;&gt; 1 OR to_user_id &lt;&gt; 1 OR signup_code_id IN (
                  	SELECT id FROM account_signupcode
                  	WHERE inviter_id &lt;&gt; 1
              	)
       	);

    	DELETE FROM pinax_invitations_joininvitation
    	WHERE from_user_id &lt;&gt; 1 OR to_user_id &lt;&gt; 1 OR signup_code_id IN (
			SELECT id FROM account_signupcode
           	WHERE inviter_id &lt;&gt; 1
       	);

    	DELETE FROM account_signupcoderesult
    	WHERE user_id &lt;&gt; 1 OR signup_code_id IN (
           	SELECT id FROM account_signupcode
           	WHERE inviter_id &lt;&gt; 1
       	);

    	DELETE FROM account_signupcode
    	WHERE inviter_id &lt;&gt; 1;

    	DELETE FROM account_emailconfirmation
    	WHERE email_address_id IN (
        	SELECT id FROM account_emailaddress
        	WHERE user_id &lt;&gt; 1
    	);

    	DELETE FROM account_emailaddress
    	WHERE user_id &lt;&gt; 1;

    	DELETE FROM account_account
    	WHERE user_id &lt;&gt; 1;

    	DELETE FROM account_accountdeletion
    	WHERE user_id &lt;&gt; 1;

    	DELETE FROM account_passwordexpiry
    	WHERE user_id &lt;&gt; 1;

    	DELETE FROM account_passwordhistory
    	WHERE user_id &lt;&gt; 1;

    	DELETE FROM reversion_version
    	WHERE revision_id IN (
        	SELECT id FROM reversion_revision
        	WHERE user_id &lt;&gt; 1
    	);

    	DELETE FROM reversion_revision
    	WHERE user_id &lt;&gt; 1;

    	DELETE FROM auth_user_groups
    	WHERE user_id &lt;&gt; 1;

    	DELETE FROM auth_user_user_permissions
    	WHERE user_id &lt;&gt; 1;

    	UPDATE helpdesk_queue
    	SET default_owner_id = 1
    	WHERE default_owner_id &lt;&gt; 1;

    	UPDATE pinax_teams_team
    	SET creator_id = 1
    	WHERE creator_id &lt;&gt; 1;

    	DELETE FROM auth_user
    	WHERE id &lt;&gt; 1;
	
END $$;</stringProp>
