              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="new_status &lt;&lt;&lt; JSR223" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def html = org.jsoup.Jsoup.parse(prev.getResponseDataAsString())

def current = (html.selectFirst(&quot;h3&quot;).text() =~ /\[([^]]+)]$/)[0][1]

def statuses = html.select(&quot;input[name=new_status]&quot;).findAll {
    it.parent().text().replaceAll(/[«»]/, &quot;&quot;).trim() != current
}

def random = statuses[new Random().nextInt(statuses.size())]

vars.put(&quot;random_status&quot;, random.val())</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
