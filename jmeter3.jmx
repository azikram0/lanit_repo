                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion">
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">def json = new groovy.json.JsonSlurper()
    .parseText(prev.getResponseDataAsString())

def countAfter = json.recordsFiltered.toString()

def idsAfter = json.data.collect {
    it.id.toString()
}.sort().join(&quot;,&quot;)

if (vars.get(&quot;count_before&quot;) != countAfter ||
    vars.get(&quot;ids_before&quot;) != idsAfter) {

    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(
        &quot; SAVED_QUERY ERROR (результаты фильтрации не совпадают)&quot;
    )
}
</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                </JSR223Assertion>
