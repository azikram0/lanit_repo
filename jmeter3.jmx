              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="ids_before &lt;&lt;&lt; JSR223">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def json = new groovy.json.JsonSlurper()
    .parseText(prev.getResponseDataAsString())

vars.put(&quot;count_before&quot;, json.recordsFiltered.toString())

def ids = json.data.collect {
    it.id.toString()
}.sort()

vars.put(&quot;ids_before&quot;, ids.join(&quot;,&quot;))
</stringProp>
