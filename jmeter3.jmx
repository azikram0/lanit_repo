              <hashTree/>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="random_offset &lt;&lt;&lt; JSR223" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def total = vars.get(&quot;count_records&quot;).toInteger()
def page_size = 25

if (total &lt;= 0) {
    vars.put(&quot;random_offset&quot;, &quot;0&quot;)
    return
}

def max_offset_index = (total - 1).intdiv(page_size)
def random_index = org.apache.commons.lang3.RandomUtils.nextInt(0, max_offset_index + 1)
def offset = random_index * page_size

log.info(&quot;total=${total}, max_offset_index=${max_offset_index}, random_index=${random_index}, offset=${offset}&quot;)
vars.put(&quot;random_offset&quot;, offset.toString())</stringProp>
              </JSR223PreProcessor>
