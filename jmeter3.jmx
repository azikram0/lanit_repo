              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="filter_field, filter_value &lt;&lt;&lt; JSR223">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def count = (vars.get(&apos;owners_matchNr&apos;) ?: &apos;0&apos;).toInteger()

def owners = (1..count).collect {
    vars.get(&quot;owners_${it}&quot;)
}

def filters = [
    assigned_to: owners,
    queue: [&apos;1&apos;, &apos;2&apos;],
    status: [&apos;1&apos;, &apos;2&apos;, &apos;3&apos;, &apos;4&apos;, &apos;5&apos;],
    kbitem: [&apos;-1&apos;, &apos;1&apos;, &apos;2&apos;, &apos;3&apos;]
]

def random = java.util.concurrent.ThreadLocalRandom.current()

def field = filters.keySet().toList().get(
    random.nextInt(filters.size())
)

def values = filters[field]
def value = values.get(random.nextInt(values.size()))

vars.put(&apos;filter_field&apos;, field)
vars.put(&apos;filter_value&apos;, value)
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PreProcessor>
